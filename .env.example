# travelapp environment variables
#
# Local development:  cp .env.example .env   (the values below work as-is)
# Production:         never reuse these values. Generate every password/secret
#                     with `openssl rand -hex 32` and keep the file only on the
#                     server, readable by its owner only (chmod 600). See ADR-0007.
#
# Rules (docs/architecture.md section 7):
# - This file lists only variables the services actually read (the M0 stack:
#   Compose, backend, worker). A feature that needs a new variable adds it here
#   in the same PR; nothing is listed "for later".
# - Real secrets never go in this file or anywhere in git. `.env` is gitignored.
# - Standard names without a prefix (DATABASE_URL, REDIS_URL) so that hosting
#   platforms such as Render can inject them unchanged (ADR-0007).
# - Hostnames `postgres`, `redis`, `minio` are Docker Compose service names.

# --- App ---------------------------------------------------------------------
# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Brand name shown to users. The only place the brand appears in config;
# code uses the code name "travelapp" everywhere else (ADR-0009).
SITE_NAME=TravelApp

# --- PostgreSQL --------------------------------------------------------------
# POSTGRES_* are read by the postgres container to create the database.
POSTGRES_USER=travelapp
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=travelapp
# Read by the backend. Standard postgresql:// form; the backend picks the driver.
DATABASE_URL=postgresql://travelapp:dev_only_change_me@postgres:5432/travelapp

# --- Redis (login sessions + Celery queue) -----------------------------------
# Password is set in development too, so dev and production look the same.
REDIS_PASSWORD=dev_only_change_me
REDIS_URL=redis://:dev_only_change_me@redis:6379/0

# --- Object storage (S3 API: MinIO locally, Cloudflare R2 in production) -----
S3_ENDPOINT_URL=http://minio:9000
# MinIO accepts us-east-1; on R2 use "auto".
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=travelapp
S3_SECRET_ACCESS_KEY=dev_only_change_me
S3_BUCKET=travelapp-media

# --- MinIO (local development only; not used in production) ------------------
# Admin account of the local MinIO container. Locally the S3_* key above is the
# same account; in production R2 issues its own key (ADR-0005).
MINIO_ROOT_USER=travelapp
MINIO_ROOT_PASSWORD=dev_only_change_me
